{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "share": "disabled",
  "env": {
    "AGENT_HISTORY_TTL_DAYS": "14",
    "OPENCODE_ENABLE_EXA": "1"
  },
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "bot/.bot-key": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "bot/.bot-key": "deny"
    },
    "bash": {
      "*": "allow",
      "git push *": "allow",
      "git reset *": "deny",
      "git clean *": "deny",
      "git rebase *": "deny",
      "git checkout *": "ask",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "shutdown *": "deny",
      "reboot": "deny",
      "mkfs*": "deny",
      "dd *": "deny",
      "chmod 777 *": "deny",
      "curl * | sh": "deny",
      "curl * | bash": "deny",
      "systemctl restart kiira-retry-proxy": "allow",
      "systemctl restart kiira-retry-proxy *": "allow",
      "systemctl status kiira-retry-proxy *": "allow",
      "systemctl stop *": "deny",
      "systemctl restart *": "ask",
      "systemctl disable *": "ask",
      "systemctl mask *": "ask",
      "pm2 *": "ask",
      "kill *": "ask"
    },
    "webfetch": "allow",
    "external_directory": {
      "**": "deny"
    }
  }
}
