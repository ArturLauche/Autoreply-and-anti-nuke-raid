# Dockerfile.web — đóng gói DASHBOARD (frontend) cho Dokploy.
# Bot Discord KHÔNG nằm trong image này — bot tiếp tục chạy trực tiếp bằng Bun
# trên VPS (process riêng, không bọc Docker — tránh phức tạp hóa).
#
# Build 2 giai đoạn (multi-stage):
#   1. node:bun  → cài deps + vite build → dist/ (file tĩnh)
#   2. nginx     → chỉ copy dist/ → serve cực nhẹ (~25MB RAM)
#
# Lưu ý build-args (điền trong Dokploy → tab Build → Build Arguments):
#   VITE_CONVEX_URL        URL deployment Convex thật (bắt buộc — mặc định đã
#                          trỏ production nên có thể bỏ trống)
#   VITE_DISCORD_CLIENT_ID application id bot (để nút đăng nhập Discord hoạt động)
#   DISCORD_CLIENT_ID      shim scripts/build.mjs tự chuyển thành VITE_DISCORD_CLIENT_ID

# ── Giai đoạn 1: build ─────────────────────────────────────────
FROM oven/bun:1 AS build
WORKDIR /app

# Copy manifest trước để cache layer (deps không đổi → không cài lại)
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Copy phần còn lại rồi build (build-args từ Dokploy tới đây qua ENV)
COPY index.html vite.config.ts tailwind.config.ts postcss.config.js tsconfig*.json ./
COPY scripts/build.mjs ./scripts/build.mjs
COPY src ./src
COPY convex ./convex

ARG VITE_CONVEX_URL=""
ARG VITE_DISCORD_CLIENT_ID=""
ARG DISCORD_CLIENT_ID=""
ENV VITE_CONVEX_URL=$VITE_CONVEX_URL \
    VITE_DISCORD_CLIENT_ID=$VITE_DISCORD_CLIENT_ID \
    DISCORD_CLIENT_ID=$DISCORD_CLIENT_ID
RUN bun run build

# ── Giai đoạn 2: serve ─────────────────────────────────────────
FROM nginx:1.27-alpine
# SPA fallback: đường dẫn nào cũng trả index.html (React Router tự xử lý)
RUN printf '%s\n' \
  "server {" \
  "  listen 80;" \
  "  server_name _;" \
  "  root /usr/share/nginx/html;" \
  "  index index.html;" \
  "  location / {" \
  "    try_files \$uri \$uri/ /index.html;" \
  "  }" \
  "  location /assets/ {" \
  "    expires 30d;" \
  "    add_header Cache-Control \"public, immutable\";" \
  "  }" \
  "}" > /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
